# ==========================================================
# EtherLove
# 03 - Progression
# PROGRESSION REBUILD 004 - GENERIC PENDING ACTIONS
# ==========================================================
# RESPONSABILIDADES:
# - /NAMORAR
# - /NOIVAR
# - /LS
# - /LN
# - exclusividade
# - Request routing
# - Generic Pending Action System
# - integração com DIVORCIO / DATE / PRESENTE
# ==========================================================

options:
    etherlove-pending-expiration: 10 minutes

# ==========================================================
# GENERIC PENDING ACTION SYSTEM
# ==========================================================
# Cada jogador pode possuir UMA ação que usa /LS ou /LN.
# Types atuais:
# REQUEST      -> NAMORAR / NOIVAR / DIVORCIO / DATE
# DATE_REVIEW
# GIFT_CONFIRM
# GIFT_REVIEW
# ==========================================================

function setPendingAction(receiver: player, type: text, sourceUUID: text, sourceName: text, relationship: text):
    set {_uuid} to "%uuid of {_receiver}%"
    set {etherlove.pending.%{_uuid}%.type} to {_type}
    set {etherlove.pending.%{_uuid}%.source-uuid} to {_sourceUUID}
    set {etherlove.pending.%{_uuid}%.source-name} to {_sourceName}
    set {etherlove.pending.%{_uuid}%.relationship} to {_relationship}
    set {etherlove.pending.%{_uuid}%.expires} to {@etherlove-pending-expiration} after now

function clearPendingAction(receiver: player):
    set {_uuid} to "%uuid of {_receiver}%"
    delete {etherlove.pending.%{_uuid}%::*}

function hasPendingAction(receiver: player) :: boolean:
    set {_uuid} to "%uuid of {_receiver}%"
    if {etherlove.pending.%{_uuid}%.type} is not set:
        return false
    if {etherlove.pending.%{_uuid}%.expires} is not set:
        clearPendingAction({_receiver})
        return false
    if {etherlove.pending.%{_uuid}%.expires} has passed:
        clearPendingAction({_receiver})
        return false
    return true

function getPendingActionType(receiver: player) :: text:
    if hasPendingAction({_receiver}) is false:
        return ""
    return {etherlove.pending.%uuid of {_receiver}%.type}

function getPendingSourceUUID(receiver: player) :: text:
    if hasPendingAction({_receiver}) is false:
        return ""
    return {etherlove.pending.%uuid of {_receiver}%.source-uuid}

function getPendingSourceName(receiver: player) :: text:
    if hasPendingAction({_receiver}) is false:
        return ""
    return {etherlove.pending.%uuid of {_receiver}%.source-name}

function getPendingRelationshipID(receiver: player) :: text:
    if hasPendingAction({_receiver}) is false:
        return ""
    return {etherlove.pending.%uuid of {_receiver}%.relationship}

# Bloqueia novas ações que exigiriam /LS ou /LN durante DATE ativo.
function isPlayerBusyForNewAction(p: player) :: boolean:
    if hasPendingAction({_p}) is true:
        return true
    if {etherlove.date.player.%uuid of {_p}%} is set:
        return true
    return false

# ==========================================================
# COMPATIBILITY WRAPPERS FOR REQUEST SYSTEM / 03B
# ==========================================================

function setIncomingRequestPointer(sender: player, receiver: player):
    setPendingAction({_receiver}, "REQUEST", "%uuid of {_sender}%", name of {_sender}, etherID({_sender}, {_receiver}))

function clearIncomingRequestPointer(receiver: player):
    if getPendingActionType({_receiver}) is "REQUEST":
        clearPendingAction({_receiver})

function hasIncomingRequestPointer(receiver: player) :: boolean:
    if hasPendingAction({_receiver}) is false:
        return false
    if getPendingActionType({_receiver}) is "REQUEST":
        return true
    return false

function getIncomingSenderUUID(receiver: player) :: text:
    if hasIncomingRequestPointer({_receiver}) is false:
        return ""
    return getPendingSourceUUID({_receiver})

function getIncomingSenderName(receiver: player) :: text:
    if hasIncomingRequestPointer({_receiver}) is false:
        return ""
    return getPendingSourceName({_receiver})

# ==========================================================
# /NAMORAR
# ==========================================================

command /namorar <player>:
    permission: etherlove.use
    permission message: &cVocê não possui permissão para usar este comando.
    trigger:
        set {_target} to arg-1

        if {_target} is player:
            send "&cVocê não pode namorar consigo mesmo."
            stop

        if isPlayerBusyForNewAction(player) is true:
            send "&cVocê já possui uma ação do EtherLove pendente ou está em um encontro."
            stop

        if isPlayerBusyForNewAction({_target}) is true:
            send "&c%name of {_target}% está ocupado com outra ação do EtherLove."
            stop

        if relationshipExists(player, {_target}) is false:
            send "&cVocê ainda não possui uma relação suficiente com &f%name of {_target}%&c."
            stop

        if canStartDatingRequest(player, {_target}) is false:
            set {_xp} to getRelationshipPoints(player, {_target})
            set {_case} to getRelationshipStage(player, {_target})
            send "&cVocê ainda não pode pedir &f%name of {_target}% &cem namoro."
            send "&7Necessário: &fCASE 3 + 400 XP."
            send "&7Atual: &fCASE %{_case}% &8| &f%{_xp}% XP."
            stop

        if hasActivePartner(player) is true:
            send "&cVocê já possui um relacionamento comprometido ativo."
            stop

        if hasActivePartner({_target}) is true:
            send "&c%name of {_target}% já possui um relacionamento comprometido."
            stop

        createRequest(player, {_target}, "NAMORAR")
        setIncomingRequestPointer(player, {_target})

        send "&d&lETHERLOVE &8» &fPedido de namoro enviado para &d%name of {_target}%&f."
        send "&7O pedido expira em aproximadamente &f10 minutos&7."
        send "&d&lETHERLOVE &8» &d%name of player% &fquer começar um namoro com você!" to {_target}
        send "&7Use &a/LS &7para aceitar ou &c/LN &7para recusar." to {_target}

# ==========================================================
# /NOIVAR
# ==========================================================

command /noivar <player>:
    permission: etherlove.use
    permission message: &cVocê não possui permissão para usar este comando.
    trigger:
        set {_target} to arg-1

        if {_target} is player:
            send "&cVocê não pode noivar consigo mesmo."
            stop

        if isPlayerBusyForNewAction(player) is true:
            send "&cVocê já possui uma ação do EtherLove pendente ou está em um encontro."
            stop

        if isPlayerBusyForNewAction({_target}) is true:
            send "&c%name of {_target}% está ocupado com outra ação do EtherLove."
            stop

        if canStartEngagementRequest(player, {_target}) is false:
            set {_xp} to getRelationshipPoints(player, {_target})
            set {_case} to getRelationshipStage(player, {_target})
            set {_status} to getRelationshipStatus(player, {_target})
            send "&cVocê ainda não pode pedir &f%name of {_target}% &cem noivado."
            send "&7Necessário: &fCASE 4 / NAMORANDO / 500 XP."
            send "&7Atual: &fCASE %{_case}% &8| &f%{_status}% &8| &f%{_xp}% XP."
            stop

        if hasActivePartner(player) is false:
            send "&cSeu vínculo de relacionamento ativo não foi encontrado."
            stop

        if hasActivePartner({_target}) is false:
            send "&cO vínculo ativo de &f%name of {_target}% &cnão foi encontrado."
            stop

        if getActivePartnerUUID(player) is not "%uuid of {_target}%":
            send "&c%name of {_target}% não é seu parceiro ativo."
            stop

        if getActivePartnerUUID({_target}) is not "%uuid of player%":
            send "&cO vínculo de relacionamento não está consistente."
            stop

        createRequest(player, {_target}, "NOIVAR")
        setIncomingRequestPointer(player, {_target})

        send "&d&lETHERLOVE &8» &fPedido de noivado enviado para &d%name of {_target}%&f."
        send "&d&lETHERLOVE &8» &d%name of player% &fquer ficar noivo de você!" to {_target}
        send "&7Use &a/LS &7para aceitar ou &c/LN &7para recusar." to {_target}

# ==========================================================
# /LS — GENERIC ACCEPT
# ==========================================================

command /ls:
    permission: etherlove.use
    permission message: &cVocê não possui permissão para usar este comando.
    trigger:
        if hasPendingAction(player) is false:
            send "&cVocê não possui nenhuma ação pendente do EtherLove."
            stop

        set {_pendingType} to getPendingActionType(player)

        # --------------------------------------------------
        # REQUESTS
        # --------------------------------------------------
        if {_pendingType} is "REQUEST":
            set {_senderUUID} to getPendingSourceUUID(player)
            set {_senderName} to getPendingSourceName(player)

            delete {_sender}
            loop all players:
                if "%uuid of loop-player%" is {_senderUUID}:
                    set {_sender} to loop-player
                    stop loop

            if {_sender} is not set:
                send "&c%{_senderName}% precisa estar online para concluir este pedido."
                stop

            if hasPendingRequest({_sender}, player) is false:
                clearPendingAction(player)
                send "&cEsse pedido não existe mais ou expirou."
                stop

            set {_type} to getRequestType({_sender}, player)

            if {_type} is "NAMORAR":
                if canStartDatingRequest({_sender}, player) is false:
                    removeRequest({_sender}, player)
                    clearPendingAction(player)
                    send "&cO relacionamento não atende mais aos requisitos para namoro."
                    stop
                if hasActivePartner({_sender}) is true:
                    removeRequest({_sender}, player)
                    clearPendingAction(player)
                    send "&c%name of {_sender}% já possui outro relacionamento ativo."
                    stop
                if hasActivePartner(player) is true:
                    removeRequest({_sender}, player)
                    clearPendingAction(player)
                    send "&cVocê já possui outro relacionamento ativo."
                    stop

                setDatingRelationship({_sender}, player)
                removeRequest({_sender}, player)
                clearPendingAction(player)
                send "&d&lETHERLOVE &8» &aPedido aceito!"
                send "&fVocê agora está namorando &d%name of {_sender}%&f."
                send "&d&lETHERLOVE &8» &a%name of player% aceitou seu pedido de namoro!" to {_sender}
                stop

            if {_type} is "NOIVAR":
                if canStartEngagementRequest({_sender}, player) is false:
                    removeRequest({_sender}, player)
                    clearPendingAction(player)
                    send "&cA relação não atende mais aos requisitos para noivado."
                    stop
                if hasActivePartner({_sender}) is false or hasActivePartner(player) is false:
                    removeRequest({_sender}, player)
                    clearPendingAction(player)
                    send "&cO vínculo do relacionamento não está mais ativo."
                    stop
                if getActivePartnerUUID({_sender}) is not "%uuid of player%":
                    removeRequest({_sender}, player)
                    clearPendingAction(player)
                    send "&cO vínculo do relacionamento mudou antes da resposta."
                    stop
                if getActivePartnerUUID(player) is not "%uuid of {_sender}%":
                    removeRequest({_sender}, player)
                    clearPendingAction(player)
                    send "&cO vínculo do relacionamento mudou antes da resposta."
                    stop

                setEngagedRelationship({_sender}, player)
                removeRequest({_sender}, player)
                clearPendingAction(player)
                send "&d&lETHERLOVE &8» &aPedido aceito!"
                send "&fVocê agora está noivo de &d%name of {_sender}%&f."
                send "&d&lETHERLOVE &8» &a%name of player% aceitou seu pedido de noivado!" to {_sender}
                stop

            if {_type} is "DIVORCIO":
                acceptDivorce({_sender}, player)
                removeRequest({_sender}, player)
                clearPendingAction(player)
                send "&7Você aceitou o divórcio."
                stop

            if {_type} is "DATE":
                startDateEvent({_sender}, player)
                removeRequest({_sender}, player)
                clearPendingAction(player)
                stop

            removeRequest({_sender}, player)
            clearPendingAction(player)
            send "&cO tipo deste pedido não é reconhecido pelo EtherLove."
            stop

        # --------------------------------------------------
        # LOCAL / EVENT ACTIONS
        # --------------------------------------------------
        if {_pendingType} is "DATE_REVIEW":
            handleDateReviewPositive(player)
            stop

        if {_pendingType} is "GIFT_CONFIRM":
            confirmGiftSend(player)
            stop

        if {_pendingType} is "GIFT_REVIEW":
            handleGiftReviewPositive(player)
            stop

        clearPendingAction(player)
        send "&cA ação pendente não é reconhecida pelo EtherLove."

# ==========================================================
# /LN — GENERIC REJECT
# ==========================================================

command /ln:
    permission: etherlove.use
    permission message: &cVocê não possui permissão para usar este comando.
    trigger:
        if hasPendingAction(player) is false:
            send "&cVocê não possui nenhuma ação pendente do EtherLove."
            stop

        set {_pendingType} to getPendingActionType(player)

        if {_pendingType} is "REQUEST":
            set {_senderUUID} to getPendingSourceUUID(player)
            set {_senderName} to getPendingSourceName(player)

            delete {_sender}
            loop all players:
                if "%uuid of loop-player%" is {_senderUUID}:
                    set {_sender} to loop-player
                    stop loop

            if {_sender} is not set:
                send "&c%{_senderName}% precisa estar online para processarmos esta resposta."
                stop

            if hasPendingRequest({_sender}, player) is false:
                clearPendingAction(player)
                send "&cEsse pedido não existe mais ou expirou."
                stop

            set {_type} to getRequestType({_sender}, player)

            if {_type} is "NAMORAR":
                addRelationshipPoints({_sender}, player, -50)
                removeRequest({_sender}, player)
                clearPendingAction(player)
                send "&cVocê recusou o pedido de namoro de &f%name of {_sender}%&c."
                send "&7Relacionamento: &c-50 XP"
                send "&d&lETHERLOVE &8» &c%name of player% recusou seu pedido de namoro." to {_sender}
                stop

            if {_type} is "NOIVAR":
                addRelationshipPoints({_sender}, player, -50)
                removeRequest({_sender}, player)
                clearPendingAction(player)
                send "&cVocê recusou o pedido de noivado de &f%name of {_sender}%&c."
                send "&7Relacionamento: &c-50 XP"
                send "&d&lETHERLOVE &8» &c%name of player% recusou seu pedido de noivado." to {_sender}
                stop

            if {_type} is "DIVORCIO":
                refuseDivorce({_sender}, player)
                stop

            if {_type} is "DATE":
                removeRequest({_sender}, player)
                clearPendingAction(player)
                send "&7Você recusou o convite para encontro."
                send "&7%name of player% recusou seu convite para encontro." to {_sender}
                stop

            removeRequest({_sender}, player)
            clearPendingAction(player)
            send "&cO tipo deste pedido não é reconhecido pelo EtherLove."
            stop

        if {_pendingType} is "DATE_REVIEW":
            handleDateReviewNegative(player)
            stop

        if {_pendingType} is "GIFT_CONFIRM":
            cancelGiftSend(player)
            stop

        if {_pendingType} is "GIFT_REVIEW":
            handleGiftReviewNegative(player)
            stop

        clearPendingAction(player)
        send "&cA ação pendente não é reconhecida pelo EtherLove."

