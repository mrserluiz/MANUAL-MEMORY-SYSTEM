# ==========================================================
# FUTURE DATA STORAGE LAYER
# SQL / SQLITE / MYSQL / MARIADB
# ==========================================================
#
# STATUS:
# NOT IMPLEMENTED
#
# EtherLove atualmente utiliza as variáveis persistentes
# nativas do Skript como armazenamento oficial.
#
# FUTURO:
#
# A arquitetura deverá permitir substituir ou complementar:
#
# {etherlove.couple.%id%.points}
# {etherlove.couple.%id%.stage}
# {etherlove.couple.%id%.status}
# {etherlove.couple.%id%.created}
# {etherlove.couple.%id%.last-interaction}
#
# por uma camada SQL.
#
# ----------------------------------------------------------
# MODELO DE DADOS PLANEJADO
# ----------------------------------------------------------
#
# TABLE: etherlove_relationships
#
# relationship_id
# uuid_a
# uuid_b
# xp
# relationship_case
# status
# created_at
# last_interaction
#
# PRIMARY KEY:
# relationship_id
#
# ----------------------------------------------------------
# FUTURE HISTORY TABLE
# ----------------------------------------------------------
#
# TABLE: etherlove_relationship_history
#
# event_id
# relationship_id
# event_type
# actor_uuid
# target_uuid
# xp_change
# old_case
# new_case
# created_at
#
# Poderá registrar futuramente:
#
# RP
# AB
# BJ
# DATE
# PRESENTE
# NAMORO
# NOIVADO
# CASAMENTO
# DIVORCIO
# XP_POSITIVO
# XP_NEGATIVO
#
# ----------------------------------------------------------
# ARQUITETURA
# ----------------------------------------------------------
#
# COMMANDS / EVENTS
#        |
#        v
# ETHERLOVE CORE API
#        |
#        v
# STORAGE LAYER
#        |
#        +---- SKRIPT VARIABLES [CURRENT]
#        |
#        +---- SQL DATABASE [FUTURE]
#
# IMPORTANTE:
#
# Os outros módulos NÃO deverão acessar SQL diretamente.
#
# Toda leitura/escrita deverá continuar passando pelas
# funções públicas do Core:
#
# getRelationshipPoints()
# setRelationshipPoints()
# addRelationshipPoints()
# getRelationshipStage()
# setRelationshipStage()
# getRelationshipStatus()
# setRelationshipStatus()
# createRelationship()
# relationshipExists()
#
# Assim será possível alterar o mecanismo de armazenamento
# futuramente sem reescrever:
#
# 01-utils
# 02-interactions
# 03-progression
# interfaces
# eventos
# comandos
#
# ----------------------------------------------------------
# MIGRATION PLAN
# ----------------------------------------------------------
#
# FUTURE:
#
# Skript Variables
#       |
#       v
# Migration
#       |
#       v
# SQL
#
# RelationshipID continuará sendo a chave lógica oficial.
#
# UUIDs continuarão sendo utilizados para identificar
# jogadores independentemente de alteração de nickname.
#
# ==========================================================
