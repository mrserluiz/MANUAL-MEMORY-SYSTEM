# ==========================================================
# EtherLove Core - REBUILD 001
# CORE REVISION 005 - OFFLINE UUID RELATIONSHIP API
# ==========================================================
# RESPONSABILIDADES:
# - RelationshipID
# - criação e existência de relacionamentos
# - armazenamento de XP
# - cálculo de CASE
# - STATUS
# - progressão / regressão
# - exclusividade via Active Partner Index
# - operações por UUID para eventos offline-safe
# - reset da relação
# ==========================================================

options:
    max-xp: 500
    case-0: 0
    case-1: 100
    case-2: 200
    case-3: 300
    dating-min-xp: 400
    engaged-min-xp: 350
    engagement-request-xp: 500

# ==========================================================
# RELATIONSHIP ID
# ==========================================================

function etherID(p1: player, p2: player) :: text:
    set {_u1} to "%uuid of {_p1}%"
    set {_u2} to "%uuid of {_p2}%"
    return etherIDFromUUIDs({_u1}, {_u2})

function etherIDFromUUIDs(uuid1: text, uuid2: text) :: text:
    if {_uuid1} is less than {_uuid2}:
        return "%{_uuid1}%::%{_uuid2}%"
    return "%{_uuid2}%::%{_uuid1}%"

# ==========================================================
# RELATIONSHIP EXISTENCE / CREATION
# ==========================================================

function relationshipExists(p1: player, p2: player) :: boolean:
    return relationshipExistsByUUIDs("%uuid of {_p1}%", "%uuid of {_p2}%")

function relationshipExistsByUUIDs(uuid1: text, uuid2: text) :: boolean:
    set {_id} to etherIDFromUUIDs({_uuid1}, {_uuid2})
    if {etherlove.couple.%{_id}%.created} is set:
        return true
    return false

function createRelationship(p1: player, p2: player):
    set {_id} to etherID({_p1}, {_p2})
    if {etherlove.couple.%{_id}%.created} is not set:
        set {etherlove.couple.%{_id}%.created} to now
        set {etherlove.couple.%{_id}%.points} to 0
        set {etherlove.couple.%{_id}%.stage} to 0
        set {etherlove.couple.%{_id}%.status} to "SOLTEIRO"
        set {etherlove.couple.%{_id}%.last-interaction} to now

# ==========================================================
# XP STAGE CALCULATOR
# ==========================================================

function calculateXPStage(points: number) :: number:
    if {_points} >= {@case-3}:
        return 3
    if {_points} >= {@case-2}:
        return 2
    if {_points} >= {@case-1}:
        return 1
    return 0

# ==========================================================
# PLAYER XP API
# ==========================================================

function getRelationshipPoints(p1: player, p2: player) :: number:
    createRelationship({_p1}, {_p2})
    return getRelationshipPointsByUUIDs("%uuid of {_p1}%", "%uuid of {_p2}%")

function setRelationshipPoints(p1: player, p2: player, points: number):
    createRelationship({_p1}, {_p2})
    setRelationshipPointsByUUIDs("%uuid of {_p1}%", "%uuid of {_p2}%", {_points})

function addRelationshipPoints(p1: player, p2: player, amount: number):
    createRelationship({_p1}, {_p2})
    addRelationshipPointsByUUIDs("%uuid of {_p1}%", "%uuid of {_p2}%", {_amount})

# ==========================================================
# UUID / OFFLINE-SAFE XP API
# ==========================================================
# Esta camada permite que MAILBOX, avaliações e divórcio
# alterem uma relação mesmo quando um participante estiver
# offline. CASE 6 continua com XP congelado.
# ==========================================================

function getRelationshipPointsByUUIDs(uuid1: text, uuid2: text) :: number:
    set {_id} to etherIDFromUUIDs({_uuid1}, {_uuid2})
    if {etherlove.couple.%{_id}%.points} is not set:
        return 0
    return {etherlove.couple.%{_id}%.points}

function getRelationshipStageByUUIDs(uuid1: text, uuid2: text) :: number:
    set {_id} to etherIDFromUUIDs({_uuid1}, {_uuid2})
    if {etherlove.couple.%{_id}%.stage} is not set:
        return 0
    return {etherlove.couple.%{_id}%.stage}

function getRelationshipStatusByUUIDs(uuid1: text, uuid2: text) :: text:
    set {_id} to etherIDFromUUIDs({_uuid1}, {_uuid2})
    if {etherlove.couple.%{_id}%.status} is not set:
        return "SOLTEIRO"
    return {etherlove.couple.%{_id}%.status}

function setRelationshipPointsByUUIDs(uuid1: text, uuid2: text, points: number):
    if relationshipExistsByUUIDs({_uuid1}, {_uuid2}) is false:
        return

    set {_id} to etherIDFromUUIDs({_uuid1}, {_uuid2})
    set {_stage} to getRelationshipStageByUUIDs({_uuid1}, {_uuid2})

    if {_stage} is 6:
        return

    if {_points} < 0:
        set {_points} to 0
    if {_points} > {@max-xp}:
        set {_points} to {@max-xp}

    set {etherlove.couple.%{_id}%.points} to {_points}
    set {etherlove.couple.%{_id}%.last-interaction} to now
    updateRelationshipStageByUUIDs({_uuid1}, {_uuid2})

function addRelationshipPointsByUUIDs(uuid1: text, uuid2: text, amount: number):
    if relationshipExistsByUUIDs({_uuid1}, {_uuid2}) is false:
        return
    if getRelationshipStageByUUIDs({_uuid1}, {_uuid2}) is 6:
        return

    set {_current} to getRelationshipPointsByUUIDs({_uuid1}, {_uuid2})
    add {_amount} to {_current}
    setRelationshipPointsByUUIDs({_uuid1}, {_uuid2}, {_current})

# ==========================================================
# CASE / STATUS PLAYER API
# ==========================================================

function getRelationshipStage(p1: player, p2: player) :: number:
    createRelationship({_p1}, {_p2})
    return getRelationshipStageByUUIDs("%uuid of {_p1}%", "%uuid of {_p2}%")

function setRelationshipStage(p1: player, p2: player, stage: number):
    createRelationship({_p1}, {_p2})
    set {_id} to etherID({_p1}, {_p2})
    if {_stage} < 0:
        set {_stage} to 0
    if {_stage} > 6:
        set {_stage} to 6
    set {etherlove.couple.%{_id}%.stage} to {_stage}

function getRelationshipStatus(p1: player, p2: player) :: text:
    createRelationship({_p1}, {_p2})
    return getRelationshipStatusByUUIDs("%uuid of {_p1}%", "%uuid of {_p2}%")

function setRelationshipStatus(p1: player, p2: player, status: text):
    createRelationship({_p1}, {_p2})
    set {_id} to etherID({_p1}, {_p2})
    set {etherlove.couple.%{_id}%.status} to {_status}

# ==========================================================
# ACTIVE PARTNER INDEX
# ==========================================================

function hasActivePartner(p: player) :: boolean:
    if {etherlove.player.%uuid of {_p}%.partner} is set:
        return true
    return false

function getActivePartnerUUID(p: player) :: text:
    if {etherlove.player.%uuid of {_p}%.partner} is set:
        return {etherlove.player.%uuid of {_p}%.partner}
    return ""

function getActiveRelationshipID(p: player) :: text:
    if hasActivePartner({_p}) is false:
        return ""
    set {_partnerUUID} to getActivePartnerUUID({_p})
    return etherIDFromUUIDs("%uuid of {_p}%", {_partnerUUID})

function bindActivePartners(p1: player, p2: player):
    set {etherlove.player.%uuid of {_p1}%.partner} to "%uuid of {_p2}%"
    set {etherlove.player.%uuid of {_p2}%.partner} to "%uuid of {_p1}%"

function clearActivePartners(p1: player, p2: player):
    clearActivePartnersByUUIDs("%uuid of {_p1}%", "%uuid of {_p2}%")

function clearActivePartnersByUUIDs(uuid1: text, uuid2: text):
    delete {etherlove.player.%{_uuid1}%.partner}
    delete {etherlove.player.%{_uuid2}%.partner}

# ==========================================================
# UPDATE RELATIONSHIP CASE / STATUS
# ==========================================================

function updateRelationshipStage(p1: player, p2: player):
    createRelationship({_p1}, {_p2})
    updateRelationshipStageByUUIDs("%uuid of {_p1}%", "%uuid of {_p2}%")

function updateRelationshipStageByUUIDs(uuid1: text, uuid2: text):
    if relationshipExistsByUUIDs({_uuid1}, {_uuid2}) is false:
        return

    set {_id} to etherIDFromUUIDs({_uuid1}, {_uuid2})
    set {_points} to getRelationshipPointsByUUIDs({_uuid1}, {_uuid2})
    set {_stage} to getRelationshipStageByUUIDs({_uuid1}, {_uuid2})

    # CASE 6 — CASADO / XP congelado
    if {_stage} is 6:
        set {etherlove.couple.%{_id}%.status} to "CASADO"
        return

    # CASE 5 — NOIVO
    if {_stage} is 5:
        if {_points} >= {@engaged-min-xp}:
            set {etherlove.couple.%{_id}%.status} to "NOIVO"
            return

        set {etherlove.couple.%{_id}%.stage} to 4
        set {etherlove.couple.%{_id}%.status} to "NAMORANDO"

        if {_points} < {@dating-min-xp}:
            set {_xpStage} to calculateXPStage({_points})
            set {etherlove.couple.%{_id}%.stage} to {_xpStage}
            set {etherlove.couple.%{_id}%.status} to "SOLTEIRO"
            clearActivePartnersByUUIDs({_uuid1}, {_uuid2})
        return

    # CASE 4 — NAMORANDO
    if {_stage} is 4:
        if {_points} >= {@dating-min-xp}:
            set {etherlove.couple.%{_id}%.status} to "NAMORANDO"
            return

        set {_xpStage} to calculateXPStage({_points})
        set {etherlove.couple.%{_id}%.stage} to {_xpStage}
        set {etherlove.couple.%{_id}%.status} to "SOLTEIRO"
        clearActivePartnersByUUIDs({_uuid1}, {_uuid2})
        return

    # CASE 0-3 — XP driven
    set {_xpStage} to calculateXPStage({_points})
    set {etherlove.couple.%{_id}%.stage} to {_xpStage}
    set {etherlove.couple.%{_id}%.status} to "SOLTEIRO"

# ==========================================================
# RELATIONSHIP STATE TRANSITIONS
# ==========================================================

function setDatingRelationship(p1: player, p2: player):
    createRelationship({_p1}, {_p2})
    setRelationshipStage({_p1}, {_p2}, 4)
    setRelationshipStatus({_p1}, {_p2}, "NAMORANDO")
    bindActivePartners({_p1}, {_p2})

function setEngagedRelationship(p1: player, p2: player):
    createRelationship({_p1}, {_p2})
    setRelationshipStage({_p1}, {_p2}, 5)
    setRelationshipStatus({_p1}, {_p2}, "NOIVO")

function setMarriedRelationship(p1: player, p2: player):
    createRelationship({_p1}, {_p2})
    setRelationshipStage({_p1}, {_p2}, 6)
    setRelationshipStatus({_p1}, {_p2}, "CASADO")

# ==========================================================
# RESET RELATIONSHIP
# ==========================================================

function resetRelationship(p1: player, p2: player):
    createRelationship({_p1}, {_p2})
    resetRelationshipByUUIDs("%uuid of {_p1}%", "%uuid of {_p2}%")

function resetRelationshipByUUIDs(uuid1: text, uuid2: text):
    set {_id} to etherIDFromUUIDs({_uuid1}, {_uuid2})
    set {etherlove.couple.%{_id}%.points} to 0
    set {etherlove.couple.%{_id}%.stage} to 0
    set {etherlove.couple.%{_id}%.status} to "SOLTEIRO"
    set {etherlove.couple.%{_id}%.last-interaction} to now
    clearActivePartnersByUUIDs({_uuid1}, {_uuid2})

# ==========================================================
# HELPERS
# ==========================================================

function getStageName(stage: number) :: text:
    if {_stage} is 0:
        return "NEUTRO"
    if {_stage} is 1:
        return "AMIGO"
    if {_stage} is 2:
        return "MELHORES AMIGOS"
    if {_stage} is 3:
        return "PAIXAO"
    if {_stage} is 4:
        return "NAMORANDO"
    if {_stage} is 5:
        return "NOIVO"
    if {_stage} is 6:
        return "CASADO"
    return "DESCONHECIDO"

function hasStage(p1: player, p2: player, minimum: number) :: boolean:
    if getRelationshipStage({_p1}, {_p2}) >= {_minimum}:
        return true
    return false

function canStartDatingRequest(p1: player, p2: player) :: boolean:
    if relationshipExists({_p1}, {_p2}) is false:
        return false
    if getRelationshipPoints({_p1}, {_p2}) < {@dating-min-xp}:
        return false
    if getRelationshipStage({_p1}, {_p2}) is not 3:
        return false
    if getRelationshipStatus({_p1}, {_p2}) is not "SOLTEIRO":
        return false
    return true

function canStartEngagementRequest(p1: player, p2: player) :: boolean:
    if relationshipExists({_p1}, {_p2}) is false:
        return false
    if getRelationshipStage({_p1}, {_p2}) is not 4:
        return false
    if getRelationshipStatus({_p1}, {_p2}) is not "NAMORANDO":
        return false
    if getRelationshipPoints({_p1}, {_p2}) < {@engagement-request-xp}:
        return false
    return true

function isCommittedRelationship(p1: player, p2: player) :: boolean:
    if getRelationshipStage({_p1}, {_p2}) >= 4:
        return true
    return false

function isDatingRelationship(p1: player, p2: player) :: boolean:
    if getRelationshipStage({_p1}, {_p2}) is 4:
        if getRelationshipStatus({_p1}, {_p2}) is "NAMORANDO":
            return true
    return false

function isEngagedRelationship(p1: player, p2: player) :: boolean:
    if getRelationshipStage({_p1}, {_p2}) is 5:
        if getRelationshipStatus({_p1}, {_p2}) is "NOIVO":
            return true
    return false

function isMarriedRelationship(p1: player, p2: player) :: boolean:
    if getRelationshipStage({_p1}, {_p2}) is 6:
        if getRelationshipStatus({_p1}, {_p2}) is "CASADO":
            return true
    return false

# ==========================================================
# DEBUG
# ==========================================================

command /eldebug <player>:
    permission: etherlove.admin
    trigger:
        set {_target} to arg-1
        loop all players:
            if loop-player is not {_target}:
                if relationshipExists({_target}, loop-player) is true:
                    set {_points} to getRelationshipPoints({_target}, loop-player)
                    set {_stage} to getRelationshipStage({_target}, loop-player)
                    set {_status} to getRelationshipStatus({_target}, loop-player)
                    send "&dDebug: %name of {_target}% + %name of loop-player% | CASE: %{_stage}% (%getStageName({_stage})%) | XP: %{_points}% | STATUS: %{_status}%"

