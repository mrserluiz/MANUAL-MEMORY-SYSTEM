# ==========================================================
# EtherLove
# 02 - Interactions
# INTERACTIONS REVISION 002 - PLAYER-FACING STAGE NAMES
# ==========================================================
# /RP /AB /BJ
# CASE continua sendo controle interno.
# Jogadores veem apenas o nome do estado.
# ==========================================================

command /rp <player>:
    permission: etherlove.use
    permission message: &cVocê não possui permissão para usar este comando.
    trigger:
        set {_target} to arg-1
        if {_target} is player:
            send "&cVocê não pode usar uma interação consigo mesmo."
            stop

        set {_relationshipID} to etherID(player, {_target})
        if relationshipExists(player, {_target}) is false:
            createRelationship(player, {_target})

        if canUseRP(player) is false:
            send "&cVocê ainda está no cooldown do &d/RP&c."
            stop

        addRelationshipPoints(player, {_target}, 10)
        set {etherlove.couple.%{_relationshipID}%.last-interaction} to now
        startRPCooldown(player)

        set {_xp} to getRelationshipPoints(player, {_target})
        set {_stage} to getRelationshipStage(player, {_target})
        set {_state} to getStageName({_stage})

        send "&d&lETHERLOVE &8» &fVocê demonstrou carinho por &d%name of {_target}%&f."
        send "&7Relacionamento: &f+10 XP"
        send "&7XP atual: &d%{_xp}%&7/500"
        send "&7Estado: &d%{_state}%"

command /ab <player>:
    permission: etherlove.use
    permission message: &cVocê não possui permissão para usar este comando.
    trigger:
        set {_target} to arg-1
        if {_target} is player:
            send "&cVocê não pode usar uma interação consigo mesmo."
            stop

        set {_relationshipID} to etherID(player, {_target})
        if relationshipExists(player, {_target}) is false:
            send "&cVocê ainda não possui uma relação registrada com &f%name of {_target}%&c."
            send "&7Use &f/RP %name of {_target}% &7para iniciar a relação."
            stop

        set {_stage} to getRelationshipStage(player, {_target})
        if {_stage} < 1:
            send "&cVocê precisa alcançar o estado &bAMIGO &cpara usar &f/AB&c."
            stop

        if canUseAB(player) is false:
            send "&cVocê ainda está no cooldown do &d/AB&c."
            stop

        addRelationshipPoints(player, {_target}, 10)
        set {etherlove.couple.%{_relationshipID}%.last-interaction} to now
        startABCooldown(player)

        set {_xp} to getRelationshipPoints(player, {_target})
        set {_newStage} to getRelationshipStage(player, {_target})
        set {_state} to getStageName({_newStage})

        send "&d&lETHERLOVE &8» &fVocê teve uma interação especial com &d%name of {_target}%&f."
        send "&7Relacionamento: &f+10 XP"
        send "&7XP atual: &d%{_xp}%&7/500"
        send "&7Estado: &d%{_state}%"

command /bj <player>:
    permission: etherlove.use
    permission message: &cVocê não possui permissão para usar este comando.
    trigger:
        set {_target} to arg-1
        if {_target} is player:
            send "&cVocê não pode usar uma interação consigo mesmo."
            stop

        set {_relationshipID} to etherID(player, {_target})
        if relationshipExists(player, {_target}) is false:
            send "&cVocê ainda não possui uma relação registrada com &f%name of {_target}%&c."
            stop

        set {_stage} to getRelationshipStage(player, {_target})
        if {_stage} < 3:
            send "&cVocê precisa alcançar o estado &dPAIXAO &cpara usar &f/BJ&c."
            stop

        if canUseBJ(player, {_target}) is false:
            send "&cVocê ainda está no cooldown do &d/BJ&c com &f%name of {_target}%&c."
            stop

        addRelationshipPoints(player, {_target}, 15)
        set {etherlove.couple.%{_relationshipID}%.last-interaction} to now
        startBJCooldown(player, {_target})

        set {_xp} to getRelationshipPoints(player, {_target})
        set {_newStage} to getRelationshipStage(player, {_target})
        set {_state} to getStageName({_newStage})

        send "&d&lETHERLOVE &8» &fVocê realizou uma interação íntima com &d%name of {_target}%&f."
        send "&7Relacionamento: &f+15 XP"
        send "&7XP atual: &d%{_xp}%&7/500"
        send "&7Estado: &d%{_state}%"

# /DATE e /PRESENTE vivem em 03c-etherlove-events.sk
