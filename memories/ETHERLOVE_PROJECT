options:
    rp-cooldown: 12 hours
    ab-cooldown: 50 seconds
    bj-cooldown: 80 seconds
#
# ==========================================================
# FUNÇÕES
# ==========================================================
#
#
# RP
#
function canUseRP(p: player) :: boolean:
    if {etherlove.cooldown.rp.%uuid of {_p}%} is not set:
        return true
    if difference between now and {etherlove.cooldown.rp.%uuid of {_p}%} >= {@rp-cooldown}:
        return true
    return false
function getRPRemaining(p: player) :: timespan:
    if {etherlove.cooldown.rp.%uuid of {_p}%} is not set:
        return 0 seconds
    return {@rp-cooldown} - (difference between now and {etherlove.cooldown.rp.%uuid of {_p}%})
function startRPCooldown(p: player):
    set {etherlove.cooldown.rp.%uuid of {_p}%} to now
# AB
function canUseAB(p: player) :: boolean:

    if {etherlove.cooldown.ab.%uuid of {_p}%} is not set:
        return true
    if difference between now and {etherlove.cooldown.ab.%uuid of {_p}%} >= {@ab-cooldown}:
        return true
    return false
function getABRemaining(p: player) :: timespan:
    if {etherlove.cooldown.ab.%uuid of {_p}%} is not set:
        return 0 seconds
    return {@ab-cooldown} - (difference between now and {etherlove.cooldown.ab.%uuid of {_p}%})
function startABCooldown(p: player):
    set {etherlove.cooldown.ab.%uuid of {_p}%} to now
#
# BJ
#
# Cooldown compartilhado pelo casal
#
function canUseBJ(p1: player, p2: player) :: boolean:
    set {_id} to etherID({_p1}, {_p2})
    if {etherlove.cooldown.bj.%{_id}%} is not set:
        return true
    if difference between now and {etherlove.cooldown.bj.%{_id}%} >= {@bj-cooldown}:
        return true
    return false
function getBJRemaining(p1: player, p2: player) :: timespan:
    set {_id} to etherID({_p1}, {_p2})
    if {etherlove.cooldown.bj.%{_id}%} is not set:
        return 0 seconds
    return {@bj-cooldown} - (difference between now and {etherlove.cooldown.bj.%{_id}%})

function startBJCooldown(p1: player, p2: player):
    set {_id} to etherID({_p1}, {_p2})
    set {etherlove.cooldown.bj.%{_id}%} to now
