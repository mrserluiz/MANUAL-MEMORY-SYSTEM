        if canUseRP(player) is false:
            send "&fTempo restante:"
            send "&7%getRPRemaining(player)%"
        send "&8&m------------------------------------"

# ==========================================================
# EtherLove AB
# ==========================================================
#
# /ab
#
# Abraço
#
# Requer:
# AMIGO (1) ou superior
#
# Cooldown:
# 50 segundos
#
# Ganho:
# +10 pontos
#
# ==========================================================
#
options:
    ab-points: 10
    stage-friend: 1
#
# ==========================================================
# COMANDO
# ==========================================================
#
command /ab:
    trigger:
        #
        # Cooldown
        #
        if canUseAB(player) is false:
            send "&cVocê precisa esperar para abraçar novamente."
            send "&7Tempo restante: &f%getABRemaining(player)%"
            stop
        #
        # Procura relacionamentos válidos
        #
        set {_affected} to 0
        loop all players:
            if loop-player is player:
                next loop
            if relationshipExists(player, loop-player):
                #
                # Precisa ser AMIGO+
                #
                if hasStage(player, loop-player, {@stage-friend}):
                    addRelationshipPoints(
                        player,
                        loop-player,
                        {@ab-points}
                    )
                    add 1 to {_affected}
        #
        # Nenhum relacionamento elegível
        #
        if {_affected} <= 0:
            send "&cVocê não possui nenhum relacionamento em nível AMIGO ou superior."
            stop
        #
        # Inicia cooldown
        #
        startABCooldown(player)
        send "&d❤ EtherLove"
        send "&fVocê distribuiu abraços."
        send "&a+{@ab-points}% pontos em %{_affected}% relacionamento(s)."
