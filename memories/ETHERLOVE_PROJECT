options:
    bj-points: 10
    bj-required-stage: 3
#
# ==========================================================
# /bj
# ==========================================================
#
command /bj <player>:
    trigger:
        set {_target} to arg-player
        if {_target} is not online:
            send "&cJogador não encontrado."
            stop
        if {_target} is player:
            send "&cVocê não pode usar isso em si mesmo."
            stop
        if relationshipExists(player, {_target}) is false:
            send "&cVocês não possuem relacionamento."
            stop
        if hasStage(player, {_target}, {@bj-required-stage}) is false:
            send "&cSeu relacionamento não atingiu PAIXAO."
            stop
        if canUseBJ(player, {_target}) is false:
            send "&cAguarde para usar /bj novamente."
            send "&7Tempo restante: &f%getBJRemaining(player, {_target})%"
            stop
        #
        # Cria pedido
        #
        set {_requestId} to random integer between 100000 and 999999
        set {etherlove.request.%uuid of {_target}%} to {_requestId}
        set {etherlove.request.type.%uuid of {_target}%} to "BJ"
        set {etherlove.request.sender.%uuid of {_target}%} to uuid of player
        set {etherlove.request.target.%uuid of {_target}%} to uuid of {_target}
        set {etherlove.request.expire.%uuid of {_target}%} to now
        send "&d❤ Pedido enviado para %{_target}%."
        send ""
        send "&d❤ EtherLove"
        send "&f%player% quer dar um beijo em você."
        send ""
        send "&aAceitar: /ls"
        send "&cNegar: /ln"

# ==========================================================
# EtherLove Requests
# ==========================================================
#
# Sistema universal de pedidos.
#
# Utilizado por:
# - BJ
# - NAMORO
# - DATE
# - CASAMENTO
# - OBA_OBA
# - CERIMÔNIA
#
# ==========================================================
#
options:
    request-expire-seconds: 60
#
# ==========================================================
# FUNÇÃO
# ==========================================================
#
function hasPendingRequest(p: player) :: boolean:
    if {etherlove.request.type.%uuid of {_p}%} is set:
        return true
    return false
function createRequest(sender: player, target: player, type: text):
    set {etherlove.request.type.%uuid of {_target}%} to {_type}
    set {etherlove.request.sender.%uuid of {_target}%} to uuid of {_sender}
    set {etherlove.request.created.%uuid of {_target}%} to now
# ==========================================================
# ACEITAR
# ==========================================================

command /ls:
    trigger:
        if hasPendingRequest(player) is false:
            send "&cVocê não possui pedidos pendentes."
            stop
        set {_type} to {etherlove.request.type.%uuid of player%}
        set {_senderUUID} to {etherlove.request.sender.%uuid of player%}
        set {_sender} to offline player from uuid {_senderUUID}
        #
        # BJ
        #
        if {_type} = "BJ":
            addRelationshipPoints(
                player,
                {_sender},
                10
            )
            startBJCooldown(
                player,
                {_sender}
            )
            send "&d❤ Você aceitou o beijo."
            if {_sender} is online:
                send "&d❤ %{player}% aceitou seu beijo." to {_sender}
        #
        # NAMORO
        #
        else if {_type} = "NAMORO":
            setRelationshipStage(
                player,
                {_sender},
                4
            )

            broadcast "&d❤ %player% e %{_sender}% agora estão namorando!"
        #
        # DATE
        #
        else if {_type} = "DATE":

            addRelationshipPoints(
                player,
                {_sender},
                10
            )
            send "&aEncontro aceito."
            if {_sender} is online:
                send "&aSeu encontro foi aceito." to {_sender}
        #
        # CASAMENTO
        #
        else if {_type} = "CASAMENTO":
            setRelationshipStage(
                player,
                {_sender},
                5
            )
            broadcast "&6❤ %player% e %{_sender}% ficaram noivos!"
        # OBAOBA
        else if {_type} = "OBAOBA":
            send "&d❤ Momento especial iniciado."

            if {_sender} is online:
                send "&d❤ Pedido aceito." to {_sender}
        #
        # Limpeza
        #
        delete {etherlove.request::*%uuid of player%}
