command /namorar <player>:
    trigger:
        set {_target} to arg-player
        if {_target} is not online:
            send "&cJogador não encontrado."
            stop
        if {_target} is player:
            send "&cVocê não pode namorar consigo mesmo."
            stop
        if relationshipExists(player, {_target}) is false:
            send "&cVocês ainda não possuem relacionamento."
            stop
        #
        # precisa ser PAIXAO
        #
        if hasStage(player, {_target}, {@namoro-required-stage}) is false:
            send "&cSeu relacionamento ainda não atingiu PAIXAO."
            stop

        #
        # bloqueia se já estiver acima
        #
        if getRelationshipStage(player, {_target}) >= 4:
            send "&cVocês já possuem um relacionamento avançado."
            stop
        #
        # cria pedido
        #
        createRequest(
    player,
    {_target},
    "NAMORO"
       )
        send "&d❤ Pedido de namoro enviado para %{_target}%."
        send ""
        send "&d❤ EtherLove"
        send "&f%player% quer namorar você."
        send ""
        send "&aAceitar: /ls"
        send "&cNegar: /ln"
