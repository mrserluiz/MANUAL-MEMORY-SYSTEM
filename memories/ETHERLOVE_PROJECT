# ==========================================================
# EtherLove RP
# ==========================================================
#
# /rp
#
# Interação social geral.
#
# Adiciona +10 pontos para TODOS os relacionamentos
# existentes do jogador.
#
# Cooldown:
# 12 horas
#
# ==========================================================
#
options:
    rp-points: 10
#
# ==========================================================
# COMANDO
# ==========================================================
#
command /rp:
    trigger:
        #
        # Cooldown
        #
        if canUseRP(player) is false:

            set {_remaining} to getRPRemaining(player)
            send "&cVocê já utilizou /rp."
            send "&7Tempo restante: &f%{_remaining}%"
            stop
        #
        # Inicia cooldown
        #
        startRPCooldown(player)
        #
        # Procura relacionamentos
        #
        set {_count} to 0
        loop all players:
            #
            # Ignora si mesmo
            #
            if loop-player is player:
                next loop
            #
            # Verifica relacionamento
            #
            if relationshipExists(player, loop-player):
                #
                # Adiciona pontos
                #
                addRelationshipPoints(
                    player,
                    loop-player,
                    {@rp-points}
                )

                add 1 to {_count}
        #
        # Feedback
        #
        if {_count} = 0:
            send "&eVocê ainda não possui relacionamentos registrados."
            stop
        send "&d❤ EtherLove"
        send "&fVocê fortaleceu %{_count}% relacionamento(s)."
        send "&a+{@rp-points}% pontos aplicados."
#
# ==========================================================
# DEBUG
# ==========================================================
#
command /rpdebug:
    permission: etherlove.admin
    trigger:
        send "&8&m------------------------------------"
        send "&dEtherLove RP Debug"
        send ""
        send "&fCooldown ativo:"
        send "&7%canUseRP(player)%"
        if canUseRP(player) is false:
            send "&fTempo restante:"
            send "&7%getRPRemaining(player)%"
        send "&8&m------------------------------------"

